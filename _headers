# Netlify Headers Configuration
# Ensures optimal caching and security policies across all devices and CDNs

# Default headers for all documents (HTML)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=()
  Cache-Control: public, max-age=0, must-revalidate

# Immutable caching for static assets (images, audio, fonts)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Caching for stylesheets
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Caching for JavaScript
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
